    {
      "name": "lead_companies_list",
      "title": "公司列表（线索检索）",
      "description": "按省/市/平台/解锁状态/补全状态/关键词检索公司；游标分页（meta.nextCursor）。对应 GET /v1/companies。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "province": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "boss",
              "zhilian",
              "ali",
              "mic"
            ]
          },
          "unlockStatus": {
            "type": "string",
            "enum": [
              "none",
              "pending",
              "waiting_quota",
              "unlocked",
              "failed"
            ]
          },
          "enrichmentStatus": {
            "type": "string",
            "enum": [
              "discovered",
              "source_detailed",
              "tanji_matched",
              "tanji_enriched",
              "unmatched",
              "failed"
            ]
          },
          "q": {
            "type": "string",
            "minLength": 2
          },
          "updatedSince": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "rest": {
        "method": "GET",
        "path": "/v1/companies"
      },
      "pathParams": [],
      "queryParams": [
