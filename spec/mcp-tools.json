{
  "schemaVersion": "1.0",
  "server": {
    "name": "lead-platform",
    "version": "0.1.0",
    "transport": "stdio"
  },
  "note": "MCP 默认代理 REST（不直接持有 DB）；服务未启动时返回 SERVICE_UNAVAILABLE。",
  "tools": [
    {
      "name": "lead_status",
      "title": "服务运行状态",
      "description": "LeadPlatform 运行态总览：版本、DB、队列积压、调度、上游健康、额度、告警。对应 GET /v1/status。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "rest": {
        "method": "GET",
        "path": "/v1/status"
      },
      "pathParams": [],
      "queryParams": []
    },
    {
      "name": "lead_quota",
      "title": "探迹额度",
      "description": "探迹三层额度（日用/月用/企业月）、结算日、最近 7 天解锁数与最近观测时间。对应 GET /v1/quota。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "rest": {
        "method": "GET",
        "path": "/v1/quota"
      },
      "pathParams": [],
      "queryParams": []
    },
    {
      "name": "lead_sources",
      "title": "上游来源健康",
      "description": "五个上游（boss/zhilian/ali/mic/tanji/fuma）健康、登录态、限频与最近错误。对应 GET /v1/sources。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "rest": {
        "method": "GET",
        "path": "/v1/sources"
      },
      "pathParams": [],
      "queryParams": []
    },
    {
      "name": "lead_goals_list",
      "title": "Goal 列表",
      "description": "列出区域目标 Goal；可按 enabled 过滤。对应 GET /v1/goals。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "rest": {
        "method": "GET",
        "path": "/v1/goals"
      },
      "pathParams": [],
      "queryParams": [
        "enabled",
        "limit",
        "offset"
      ]
    },
    {
      "name": "lead_goal_get",
      "title": "Goal 详情",
      "description": "Goal 详情：区域、平台、关键词、resolvedCities、最近 runs。对应 GET /v1/goals/{id}。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "业务 ID（如 cmp_xxx / goal_xxx / run_xxx）"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "rest": {
        "method": "GET",
        "path": "/v1/goals/{id}"
      },
      "pathParams": [
        "id"
      ],
      "queryParams": []
    },
    {
      "name": "lead_goal_create",
      "title": "创建 Goal",
      "description": "创建区域目标（省 + 可选城市/平台/关键词/上限/频率）。返回含 resolvedCities 的 Goal。对应 POST /v1/goals；校验失败返回 VALIDATION_ERROR。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "object",
            "properties": {
              "province": {
                "type": "string",
                "minLength": 1,
                "description": "省名（河北省）或 GB code（130000）"
              },
              "provinceCode": {
                "type": "string"
              },
              "cityCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "province"
            ],
            "additionalProperties": false
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "boss",
                "zhilian",
                "ali",
                "mic"
              ]
            }
          },
          "keywords": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "boss",
                "zhilian",
                "ali",
                "mic"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "maxLeadsPerRun": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "dailyLeadLimit": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              },
              "timeWindow": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "unlockPolicy": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "priority"
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "region"
        ],
        "additionalProperties": false
      },
      "rest": {
        "method": "POST",
        "path": "/v1/goals"
      },
      "pathParams": [],
      "queryParams": []
    },
    {
      "name": "lead_goal_update",
      "title": "更新 Goal",
      "description": "更新 Goal 字段（name/region/platforms/keywords/limits/schedule/priority/enabled）。可用 expectedVersion 乐观锁；冲突返回 CONFLICT。对应 PATCH /v1/goals/{id}。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "业务 ID（如 cmp_xxx / goal_xxx / run_xxx）"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "object",
            "properties": {
              "province": {
                "type": "string"
              },
              "provinceCode": {
                "type": "string"
              },
              "cityCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "boss",
                "zhilian",
                "ali",
                "mic"
              ]
            }
          },
          "keywords": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "boss",
                "zhilian",
                "ali",
                "mic"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "maxLeadsPerRun": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "dailyLeadLimit": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "type": "object",
            "properties": {
              "cron": {
                "type": "string"
              },
              "timeZone": {
                "type": "string"
              },
              "timeWindow": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "enabled": {
            "type": "boolean"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "rest": {
        "method": "PATCH",
        "path": "/v1/goals/{id}"
      },
      "pathParams": [
        "id"
      ],
      "queryParams": []
    },
    {
      "name": "lead_goal_run",
      "title": "手动触发 Run",
      "description": "手动触发一次采集 Run（202）。同一 Goal 已有运行中 Run 时返回 RUN_IN_PROGRESS。对应 POST /v1/goals/{id}/run。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "业务 ID（如 cmp_xxx / goal_xxx / run_xxx）"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "rest": {
        "method": "POST",
        "path": "/v1/goals/{id}/run"
      },
      "pathParams": [
        "id"
      ],
      "queryParams": []
    },
    {
      "name": "lead_runs_list",
      "title": "Run 列表",
      "description": "运行历史列表，可按 goalId/status 过滤。对应 GET /v1/runs。",
      "inputSchema": {
        "type": "object",
