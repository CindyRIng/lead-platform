{
  "schemaVersion": "1.0",
  "bin": "lead",
  "defaultBaseUrl": "http://127.0.0.1:8793",
  "globalOptions": [
    {
      "flags": "--json",
      "description": "输出与 REST data 一致的 JSON"
    },
    {
      "flags": "--base-url <url>",
      "description": "服务地址（默认 http://127.0.0.1:8793）"
    },
    {
      "flags": "--token <token>",
      "description": "Bearer token（缺省读 LEAD_API_TOKEN / config.json）"
    }
  ],
  "env": [
    "LEAD_API_TOKEN",
    "LEAD_BASE_URL"
  ],
  "commands": [
    {
      "path": "status",
      "group": "runtime",
      "description": "服务运行态总览（版本/DB/队列/上游/额度/告警）",
      "args": [],
      "options": [
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/status"
      }
    },
    {
      "path": "quota",
      "group": "runtime",
      "description": "探迹额度（日/月/企业月 + 结算日 + 近 7 天解锁）",
      "args": [],
      "options": [
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/quota"
      }
    },
    {
      "path": "sources",
      "group": "runtime",
      "description": "五个上游健康/登录态/限频/最近错误",
      "args": [],
      "options": [
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/sources"
      }
    },
    {
      "path": "stats",
      "group": "runtime",
      "description": "采集/补全/解锁/事件统计；--kind coverage 返回覆盖度",
      "args": [],
      "options": [
        {
          "flags": "--kind <kind>",
          "description": "summary|coverage|unlocks",
          "default": "summary",
          "choices": [
            "summary",
            "coverage",
            "unlocks"
          ]
        },
        {
          "flags": "--from <iso>",
          "description": "起始时间（ISO 8601）"
        },
        {
          "flags": "--to <iso>",
          "description": "结束时间（ISO 8601）"
        },
        {
          "flags": "--run-id <id>",
          "description": "限定 Run"
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/stats"
      }
    },
    {
      "path": "goal list",
      "group": "goal",
      "description": "Goal 列表",
      "args": [],
      "options": [
        {
          "flags": "--enabled",
          "description": "只看启用的"
        },
        {
          "flags": "--disabled",
          "description": "只看停用的"
        },
        {
          "flags": "--limit <n>",
          "description": "条数",
          "default": 50
        },
        {
          "flags": "--offset <n>",
          "description": "偏移",
          "default": 0
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/goals"
      }
    },
    {
      "path": "goal show <id>",
      "group": "goal",
      "description": "Goal 详情（含 resolvedCities / 最近 runs）",
      "args": [
        {
          "name": "id",
          "description": "Goal ID",
          "required": true
        }
      ],
      "options": [
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/goals/:id"
      }
    },
    {
      "path": "goal create",
      "group": "goal",
      "description": "创建 Goal（区域 + 平台 + 关键词 + 上限 + cron）",
      "args": [],
      "options": [
        {
          "flags": "--name <name>",
          "description": "Goal 名称",
          "required": true
        },
        {
          "flags": "--province <province>",
          "description": "省名或 GB code，如 河北省",
          "default": "河北省"
        },
        {
          "flags": "--city-codes <csv>",
          "description": "地级市 GB code 子集（逗号分隔；缺省=全省）"
        },
        {
          "flags": "--platforms <csv>",
          "description": "boss,zhilian,ali,mic",
          "default": "boss,zhilian,ali,mic"
        },
        {
          "flags": "--keywords-boss <csv>",
          "description": "Boss 关键词（逗号分隔）"
        },
        {
          "flags": "--keywords-zhilian <csv>",
          "description": "智联关键词（逗号分隔）"
        },
        {
          "flags": "--keywords-ali <csv>",
          "description": "Ali 行业关键词（逗号分隔）"
        },
        {
          "flags": "--max-leads <n>",
          "description": "单轮线索上限"
        },
        {
          "flags": "--daily-limit <n>",
          "description": "每日线索上限"
        },
        {
          "flags": "--cron <cron>",
          "description": "5 段 cron",
          "default": "0 2 * * *"
        },
        {
          "flags": "--priority <n>",
          "description": "优先级",
          "default": 100
        },
        {
          "flags": "--disabled",
          "description": "创建后停用"
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "POST",
        "path": "/v1/goals"
      }
    },
    {
      "path": "goal update <id>",
      "group": "goal",
      "description": "更新 Goal（--enable/--disable/--cron/--platforms/--version 等）",
      "args": [
        {
          "name": "id",
          "description": "Goal ID",
          "required": true
        }
      ],
      "options": [
        {
          "flags": "--name <name>",
          "description": "新名称"
        },
        {
          "flags": "--enable",
          "description": "启用"
        },
        {
          "flags": "--disable",
          "description": "停用"
        },
        {
          "flags": "--cron <cron>",
          "description": "新 cron"
        },
        {
          "flags": "--platforms <csv>",
          "description": "平台子集（逗号分隔）"
        },
        {
          "flags": "--keywords-boss <csv>",
          "description": "Boss 关键词（逗号分隔）"
        },
        {
          "flags": "--keywords-zhilian <csv>",
          "description": "智联关键词（逗号分隔）"
        },
        {
          "flags": "--keywords-ali <csv>",
          "description": "Ali 行业关键词（逗号分隔）"
        },
        {
          "flags": "--max-leads <n>",
          "description": "单轮线索上限"
        },
        {
          "flags": "--priority <n>",
          "description": "优先级"
        },
        {
          "flags": "--version <n>",
          "description": "乐观锁 expectedVersion"
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "PATCH",
        "path": "/v1/goals/:id"
      }
    },
    {
      "path": "goal run <id>",
      "group": "goal",
      "description": "手动触发 Run（--wait 跟随进度）",
      "args": [
        {
          "name": "id",
          "description": "Goal ID",
          "required": true
        }
      ],
      "options": [
        {
          "flags": "--wait",
          "description": "轮询跟随直到结束"
        },
        {
          "flags": "--interval <sec>",
          "description": "--wait 轮询间隔",
          "default": 5
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "POST",
        "path": "/v1/goals/:id/run"
      }
    },
    {
      "path": "goal runs <id>",
      "group": "goal",
      "description": "Goal 的运行历史",
      "args": [
        {
          "name": "id",
          "description": "Goal ID",
          "required": true
        }
      ],
      "options": [
        {
          "flags": "--limit <n>",
          "description": "条数",
          "default": 50
        },
        {
          "flags": "--offset <n>",
          "description": "偏移",
          "default": 0
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/goals/:id/runs"
      }
    },
    {
      "path": "run list",
      "group": "run",
      "description": "Run 列表",
      "args": [],
      "options": [
        {
          "flags": "--goal <id>",
          "description": "按 Goal 过滤"
        },
        {
          "flags": "--status <status>",
          "description": "pending|running|completed|partial|failed|cancelled"
        },
        {
          "flags": "--limit <n>",
          "description": "条数",
          "default": 50
        },
        {
          "flags": "--offset <n>",
          "description": "偏移",
          "default": 0
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/runs"
      }
    },
    {
      "path": "run show <id>",
      "group": "run",
      "description": "Run 详情（平台/城市/关键词进度）",
      "args": [
        {
          "name": "id",
          "description": "Run ID",
          "required": true
        }
      ],
      "options": [
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/runs/:id"
      }
    },
    {
      "path": "run cancel <id>",
      "group": "run",
      "description": "取消运行中的 Run",
      "args": [
        {
          "name": "id",
          "description": "Run ID",
          "required": true
        }
      ],
      "options": [
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "POST",
        "path": "/v1/runs/:id/cancel"
      }
    },
    {
      "path": "company list",
      "group": "company",
      "description": "公司列表（区域/平台/状态/关键词过滤，游标分页）",
      "args": [],
      "options": [
        {
          "flags": "--province <province>",
          "description": "省"
        },
        {
          "flags": "--city <city>",
          "description": "市"
        },
        {
          "flags": "--platform <platform>",
          "description": "boss|zhilian|ali|mic"
        },
        {
          "flags": "--unlock-status <status>",
          "description": "none|pending|waiting_quota|unlocked|failed"
        },
        {
          "flags": "--enrichment-status <status>",
          "description": "discovered|source_detailed|tanji_matched|tanji_enriched|unmatched|failed"
        },
        {
          "flags": "--q <keyword>",
          "description": "公司名关键词（≥2 字符）"
        },
        {
          "flags": "--updated-since <iso>",
          "description": "增量时间"
        },
        {
          "flags": "--limit <n>",
          "description": "条数",
          "default": 20
        },
        {
          "flags": "--cursor <cursor>",
          "description": "游标"
        },
        {
          "flags": "--json",
          "description": "输出与 REST data 一致的 JSON"
        }
      ],
      "rest": {
        "method": "GET",
        "path": "/v1/companies"
      }
    },
