{
  "name": "lead-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeadPlatform —— 河北外贸线索聚合 / 探迹补全 / 海关画像 / 事件订阅平台",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "lead": "dist/cli.js"
  },
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx src/main.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db && cp src/db/schema.sql dist/db/schema.sql && chmod +x dist/cli.js",
    "start": "node --experimental-sqlite dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "node --experimental-sqlite --import tsx scripts/gen.ts",
    "gen:check": "node --experimental-sqlite --import tsx scripts/gen.ts --check",
    "accept": "node --experimental-sqlite --import tsx scripts/acceptance.ts",
    "mcp": "node --experimental-sqlite dist/mcp/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^14.0.0",
    "fastify": "^5.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}