[Unit]
Description=lead-platform —— 河北外贸线索聚合/补全/海关画像/事件平台
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/lead-platform
EnvironmentFile=%h/lead-platform/.env
Environment=NODE_ENV=production
ExecStart=/nix/store/gf597zf0ysgbngwb92baxgxjd02px6jh-nodejs-22.23.2/bin/node --experimental-sqlite %h/lead-platform/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
LimitNOFILE=65535

[Install]
WantedBy=default.target
